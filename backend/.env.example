# ORION Backend — Environment Variables
# Copy this to .env and fill in your values

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:Anukriti-22@127.0.0.1:5432/orion_db

# JWT secret (change this to a long random string in production)
SECRET_KEY=orion-secret-change-this-in-production-use-random-256-bit

# Whisper model size: tiny | base | small | medium | large
# Larger = more accurate but slower. "base" is good for development.
WHISPER_MODEL=base

# Path to your custom trained sklearn model (.joblib file)
# Leave empty to use only pre-trained models
CUSTOM_MODEL_PATH=

# File upload directory
UPLOAD_DIR=uploads
